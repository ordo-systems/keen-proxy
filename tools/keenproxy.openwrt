#!/bin/sh /etc/rc.common
# KeenProxy OpenWrt service
START=99
STOP=10
USE_PROCD=1

keenproxy_root=${KEENPROXY_PREFIX:-/}
keenproxy_root=${keenproxy_root%/}
keenproxy_binary="$keenproxy_root/usr/bin/keenproxy"
keenproxy_state="$keenproxy_root/var/run/keenproxy"
keenproxy_startup_state="$keenproxy_state/startup-state"

keenproxy_lock() {
    mkdir -p "$keenproxy_state" || return 1
    keenproxy_lock_owned=0
    if [ -n "${KEENPROXY_SERVICE_LOCK_TOKEN:-}" ]; then
        local owner=
        [ ! -r "$keenproxy_state/action.lock/owner" ] ||
            read -r owner < "$keenproxy_state/action.lock/owner"
        [ "$owner" = "$KEENPROXY_SERVICE_LOCK_TOKEN" ] || {
            echo 'KeenProxy: invalid installer lock' >&2
            return 1
        }
    else
        mkdir "$keenproxy_state/action.lock" 2>/dev/null || {
            echo 'KeenProxy: service action already in progress' >&2
            return 1
        }
        keenproxy_lock_owned=1
    fi
}

keenproxy_unlock() {
    [ "${keenproxy_lock_owned:-0}" != 1 ] || rmdir "$keenproxy_state/action.lock"
    keenproxy_lock_owned=0
}

keenproxy_running() {
    local pid target
    for pid in $(pidof keenproxy 2>/dev/null); do
        target=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
        [ "$target" != "$keenproxy_binary" ] || return 0
    done
    return 1
}

keenproxy_startup_reported() {
    local pid target
    [ -f "$keenproxy_startup_state" ] && [ ! -L "$keenproxy_startup_state" ] || return 1
    # Match the marker to procd's exact instance, not an arbitrary process name.
    pid=$(ubus call service list '{"name":"keenproxy"}' |
        jsonfilter -e '@.keenproxy.instances.instance1.pid') || return 1
    case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    case "$(cat "$keenproxy_startup_state")" in
        "active $pid"|"management-only $pid") ;;
        *) return 1 ;;
    esac
    target=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
    [ "$target" = "$keenproxy_binary" ]
}

start_service() {
    local probe_status=0 protocol
    keenproxy_startup_protocol=
    # Probe before starting the daemon. A failed probe other than an unknown
    # flag must not let an existing firewall jump stand in for readiness.
    protocol=$("$keenproxy_binary" -startup-state-protocol 2>&1) || probe_status=$?
    case "$probe_status:$protocol" in
        0:1) keenproxy_startup_protocol=1 ;;
        '2:flag provided but not defined: -startup-state-protocol'*) keenproxy_startup_protocol=legacy ;;
        *) echo 'KeenProxy: could not determine the startup protocol' >&2; return 1 ;;
    esac
    # Repeated starts can keep the same instance; preserve its startup marker.
    if ! (procd_running keenproxy instance1); then
        rm -f "$keenproxy_startup_state" || return 1
    fi
    procd_open_instance instance1
    procd_set_param command "$keenproxy_binary" \
        -config "$keenproxy_root/etc/keenproxy/config.yaml" \
        -rule-sets "$keenproxy_root/var/lib/keenproxy/rule-sets" \
        -iptables "$keenproxy_root/usr/sbin/iptables" \
        -iptables-restore "$keenproxy_root/usr/sbin/iptables-restore"
    set -- "KEENPROXY_STARTUP_STATE_FILE=$keenproxy_startup_state"
    if [ -r "$keenproxy_root/etc/ssl/certs/ca-certificates.crt" ]; then
        set -- "$@" "SSL_CERT_FILE=$keenproxy_root/etc/ssl/certs/ca-certificates.crt"
    fi
    procd_set_param env "$@"
    procd_set_param term_timeout 30
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# rc.common invokes this after submitting the instance to procd. Never invoke
# rc.common recursively here: its per-service procd flock is still held.
service_started() {
    local remaining=20
    # rc.common does not propagate a start_service error to its caller.
    [ -n "${keenproxy_startup_protocol:-}" ] || return 1
    while [ "$remaining" -gt 0 ]; do
        if procd_running keenproxy instance1; then
            if keenproxy_startup_reported; then return 0; fi
            if [ "$keenproxy_startup_protocol" = legacy ] &&
                "$keenproxy_root/usr/sbin/iptables" -t nat -C PREROUTING -j KEENPROXY_DNS >/dev/null 2>&1; then
                return 0
            fi
        fi
        sleep 1
        remaining=$((remaining - 1))
    done
    echo 'KeenProxy: startup failed; inspect the system journal' >&2
    procd_kill keenproxy
    service_stopped
    return 1
}

stop_service() {
    return 0
}

# procd_kill is asynchronous. Wait for the foreground daemon to finish its
# firewall cleanup before allowing an executable replacement or rollback.
service_stopped() {
    local remaining=35
    while keenproxy_running && [ "$remaining" -gt 0 ]; do
        sleep 1
        remaining=$((remaining - 1))
    done
    if keenproxy_running; then
        echo 'KeenProxy: process did not stop cleanly' >&2
        return 1
    fi
    rm -f "$keenproxy_startup_state"
}

# Lock before rc.common loads procd.sh and takes its flock. Taking this lock
# inside a procd callback would invert the installer's lock order and deadlock.
case "${action:-}" in
    start|stop|restart|reload|boot|shutdown)
        keenproxy_lock || exit 1
        trap keenproxy_unlock EXIT
        trap 'exit 1' HUP INT TERM ;;
esac
